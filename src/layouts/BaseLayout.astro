---
import "@/styles/tailwind.css";

import { HOME_DESCRIPTION, SITE_NAME, pageTitle } from "@/site";

interface Props {
  title?: string;
  description?: string;
  pageClassNames?: string[];
  /** Keeps the page out of search results; it then has no canonical URL either. */
  noindex?: boolean;
}

const { title, description = HOME_DESCRIPTION, pageClassNames, noindex } = Astro.props;

const fullTitle = pageTitle(title);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL("/og-image.png", Astro.site);
---

<!doctype html>
<html lang="en" class:list={pageClassNames}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#b3202c" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cuprum:wght@400;500;600&display=swap" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="A scruffy Santa holding a wrapped gift next to the words You're invited: Secret Gift Exchange"
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <!-- How this works, Terms and Privacy open like a sheet: they slide up over the page you came from, and slide back
         down when you leave them (src/styles/base.css). Between two of them, or anywhere else, pages just fade. -->
    <script is:inline>
      window.addEventListener("pagereveal", (event) => {
        const transition = event.viewTransition;
        if (!transition) {
          return;
        }
        const isSheet = path => /^\/(how-it-works|privacy|terms)\/?$/.test(path);
        let fromPath = "";
        try {
          const from = new URL(window.navigation?.activation?.from?.url || document.referrer);
          fromPath = from.origin === location.origin ? from.pathname : "";
        } catch {}
        const toSheet = isSheet(location.pathname);
        const fromSheet = isSheet(fromPath);
        if (toSheet && !fromSheet) {
          transition.types.add("sheet-up");
        } else if (fromSheet && !toSheet) {
          transition.types.add("sheet-down");
        }
      });
    </script>

    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
