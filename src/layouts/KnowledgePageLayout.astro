---
import BaseLayout from "src/layouts/BaseLayout.astro";

import { Columns, Container, Content, Section } from "src/components/bulma";
import { buttonVariants } from "@/components/ui/button";

import { AstroFooter } from "src/components/hoc/AstroFooter";
import { UnsplashCredit } from "src/components/UnsplashCredit";

import "src/styles/knowledge-page.scss";
import DefaultImage from "public/screw_you.png";

interface Props {
  title?: string;
  image?: string;
  pageClassNames?: string[];
  frontmatter?: {
    title: string;
    description?: string;
    image?: string;
  };
}

const {
  title,
  image = DefaultImage.src,
  pageClassNames,
  frontmatter,
} = Astro.props;
---

<BaseLayout
  title={title ?? frontmatter?.title}
  description={frontmatter?.description}
  pageClassNames={["knowledge-page"].concat(...(pageClassNames || []))}
>
  <Container>
    <Section className={"knowledge-page-section"}>
      <Columns>
        <Columns.Column size="one-third">
          <div class:list={["knowledge-page-info"]}>
            <img src={frontmatter?.image ?? image} alt={frontmatter?.title} />

            <a
              href="/"
              class={buttonVariants({ variant: "secondary", fullWidth: true })}
              data-astro-prefetch
            >
              &#8592; Jeez, get me out of here
            </a>
          </div>
        </Columns.Column>
        <Columns.Column>
          <Content className={"knowledge-page-content"}>
            <slot />
          </Content>
        </Columns.Column>
      </Columns>
    </Section>

    <AstroFooter>
      <UnsplashCredit id="kFbSKhukfIQ" name="Erin McKenna" username="epw615" />
    </AstroFooter>
  </Container>
</BaseLayout>
