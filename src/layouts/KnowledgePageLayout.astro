---
import BaseLayout from "@/layouts/BaseLayout.astro";

import { Columns, Container, Content, Section } from "@/components/layout";
import { ArrowLeft } from "react-feather";
import { buttonVariants } from "@/components/ui/button";

import { AstroFooter } from "@/components/hoc/AstroFooter";
import { UnsplashCredit } from "@/components/UnsplashCredit";

import DefaultImage from "../../public/screw_you.png";

interface Props {
  title?: string;
  image?: string;
  pageClassNames?: string[];
  frontmatter?: {
    title: string;
    description?: string;
    image?: string;
  };
}

const {
  title,
  image = DefaultImage.src,
  pageClassNames,
  frontmatter,
} = Astro.props;
---

<BaseLayout
  title={title ?? frontmatter?.title}
  description={frontmatter?.description}
  pageClassNames={["knowledge-page"].concat(...(pageClassNames || []))}
>
  <Container>
    <Section className={"knowledge-page-section"}>
      <Columns>
        <Columns.Column size="one-third">
          <div class:list={["knowledge-page-info"]}>
            <img src={frontmatter?.image ?? image} alt={frontmatter?.title} />

            <a
              href="/"
              class={buttonVariants({ variant: "secondary", fullWidth: true })}
              data-back
            >
              <ArrowLeft size={18} aria-hidden="true" />
              Jeez, get me out of here
            </a>
          </div>
        </Columns.Column>
        <Columns.Column>
          <Content className={"knowledge-page-content"}>
            <slot />
          </Content>
        </Columns.Column>
      </Columns>
    </Section>

    <AstroFooter>
      <UnsplashCredit id="kFbSKhukfIQ" name="Erin McKenna" username="epw615" />
    </AstroFooter>
  </Container>

  <!-- "Get me out of here" goes back to the page you came from on this site; arriving from anywhere else (a search, a
       link in a new tab), it goes home as its href says. -->
  <script is:inline>
    document.querySelector("a[data-back]")?.addEventListener("click", event => {
      let cameFromHere = false;
      try {
        cameFromHere = new URL(document.referrer).origin === location.origin;
      } catch {}
      if (cameFromHere && history.length > 1) {
        event.preventDefault();
        history.back();
      }
    });
  </script>
</BaseLayout>
