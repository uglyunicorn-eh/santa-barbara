---
// The UI kit (docs/ui-kit.md): every control in every state, on the app's three surfaces. Dev only (see the
// ui-kit integration in astro.config.mjs): open http://localhost:4321/ui-kit while `npm run dev` runs.
import BaseLayout from "@/layouts/BaseLayout.astro";
import { MAX_PARTY_NAME_LENGTH, MAX_PERSON_NAME_LENGTH } from "@/limits";
import { Button, buttonVariants } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { ToastDemo } from "./ToastDemo";
import { OdometerDemo, OdometerNowAndThen, OdometerStates } from "./OdometerDemo";
import { CountdownDemo } from "./CountdownDemo";
import { cn } from "@/lib/utils";
import "./ui-kit.css";

import {
  BUTTON_VARIANTS, SURFACES, error, fieldFocus, forced, help, label, muted, onPhoto, surfaceCard, surfacePanel, surfacePhoto,
  toneOf, type State, type Surface,
} from "./recipes";

const STATES: State[] = ["default", "hover", "focus", "disabled", "loading", "live"];
const STATE_NOTES: Record<State, string> = {
  default: "resting",
  hover: "hovered",
  focus: "keyboard focus",
  disabled: "disabled",
  loading: "busy",
  live: "try it: hover, Tab",
};

// The pill buttons of the hero screens, in every state as well (glass and night only: paper has no hero screens).
const PILL_BUTTONS = [
  { variant: "brand", size: "lg", name: "brand · lg · pill", use: "A hero screen's main action", label: "Enter with your email address" },
  { variant: "secondary", size: "md", name: "secondary · pill", use: "Going home or back from a hero screen", label: "Take me home" },
] as const;

const LONG_PARTY ="TheVeryLongestSecretSantaPartyNameEver".repeat(3).slice(0, MAX_PARTY_NAME_LENGTH);
const LONG_NAME = "Maximiliana Wilhelmina Bartholomew-Featherstonehaugh".slice(0, MAX_PERSON_NAME_LENGTH);
const LONG_EMAIL = `${"santa.helper.".repeat(10).slice(0, 115)}@example.com`.slice(0, 128);

const COLOR_GROUPS: { name: string; tokens: [string, string][] }[] = [
  { name: "Turquoise (primary)", tokens: [["teal-50", "#eefcfa"], ["teal-300", "#93ecde"], ["teal-400", "#33dac1"], ["teal-500", "#00d1b2"], ["teal-700", "#007a68"], ["teal-900", "#04342c"]] },
  { name: "Red (brand, danger)", tokens: [["red-50", "#fdf3f3"], ["red-100", "#fbe3e3"], ["red-200", "#f6c6c7"], ["red-500", "#dc3a40"], ["red-600", "#c62a30"], ["red-700", "#a8222a"], ["red-800", "#8a1f25"]] },
  { name: "Zinc (neutrals)", tokens: [["zinc-50", "#fafafa"], ["zinc-100", "#f4f4f5"], ["zinc-200", "#e4e4e7"], ["zinc-300", "#d4d4d8"], ["zinc-400", "#a1a1aa"], ["zinc-500", "#71717a"], ["zinc-600", "#52525b"], ["zinc-700", "#3f3f46"], ["zinc-900", "#18181b"], ["night", "#111217"]] },
  { name: "Accents and success", tokens: [["cream", "#f7f7c6"], ["cream-50", "#fff6d6"], ["gold", "#c99700"], ["green-50", "#effaf3"], ["green-200", "#acdcbf"], ["green-700", "#257942"]] },
];
const ROLES: [string, string][] = [
  ["brand", "bg-brand"], ["primary", "bg-primary"], ["primary-hover", "bg-primary-hover"], ["destructive", "bg-destructive"],
  ["destructive-strong", "bg-destructive-strong"], ["link", "bg-link"], ["success", "bg-success"],
  ["border", "bg-border"], ["input", "bg-input"], ["ring", "bg-ring"], ["muted-foreground", "bg-muted-foreground"],
];
const TYPE: [string, string, string][] = [
  ["text-xs", "13 / 18", "Made with ❤ in Canada by Ugly Unicorn"],
  ["text-sm", "15 / 22", "Everyone must know this phrase for entry."],
  ["text-base", "18 / 28", "Hey, Alice! That's so awesome you're gathering the Office Secret Santa 2026!"],
  ["text-lg", "20 / 28", "Currently 6 nice people are participating in this."],
  ["text-xl", "24 / 32", "Let's start a new party!"],
  ["text-2xl", "30 / 36", "Office Secret Santa 2026"],
  ["text-3xl", "40 / 44", "Welcome to Anonymous Santa Clauses!"],
];

const iconX = `<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>`;

const sectionTitle = "text-2xl font-semibold";
const kicker = "text-xs font-medium uppercase tracking-wider";
const photo = (s: Surface) => `background-image: url(${surfacePhoto[s]})`;
---

<BaseLayout title="UI kit">
  <div class="min-h-dvh bg-zinc-100 font-sans text-base text-zinc-900">
    <header class="border-b border-border bg-white px-4 py-6 tablet:px-8">
      <p class={`${kicker} text-muted-foreground`}>Dev only · not in production builds</p>
      <h1 class="mt-1 text-3xl font-semibold">UI kit</h1>
      <p class="mt-2 max-w-200 text-muted-foreground">
        Every control, in every state, on the app's three
        surfaces. Buttons, inputs and toasts are the real components; the dialog and tab samples are drawn to match theirs. The rules are in
        <code class="rounded-sm bg-zinc-100 px-1 font-mono text-sm text-zinc-900">docs/ui-kit.md</code>. Hover and focus
        are shown forced, side by side; the "try it" column is live.
      </p>
      <nav class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-sm" aria-label="Sections">
        <a class="text-link underline underline-offset-4" href="#tokens">Tokens</a>
        {SURFACES.map(s => <a class="text-link underline underline-offset-4" href={`#${s.id}`}>{s.name}</a>)}
        <a class="text-link underline underline-offset-4" href="#dialogs">Dialogs</a>
        <a class="text-link underline underline-offset-4" href="#tabs">Tabs</a>
        <a class="text-link underline underline-offset-4" href="#countdown">Countdown</a>
        <a class="text-link underline underline-offset-4" href="#toasts">Toasts</a>
        <a class="text-link underline underline-offset-4" href="#party-o-meter">Party'o'meter</a>
        <a class="text-link underline underline-offset-4" href="#long-values">Long values</a>
      </nav>
    </header>

    <!-- Tokens -->
    <section id="tokens" class="space-y-8 px-4 py-8 tablet:px-8">
      <h2 class={sectionTitle}>Tokens</h2>

      {COLOR_GROUPS.map(group => (
        <div>
          <h3 class="text-lg font-semibold">{group.name}</h3>
          <div class="mt-3 grid grid-cols-2 gap-3 tablet:grid-cols-5 desktop:grid-cols-10">
            {group.tokens.map(([name, hex]) => (
              <div class="overflow-hidden rounded-lg border border-border bg-white">
                <div class="h-12 border-b border-border" style={`background: var(--color-${name})`}></div>
                <div class="px-2 py-1.5">
                  <div class="text-sm font-medium">{name}</div>
                  <div class="font-mono text-xs text-muted-foreground">{hex}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}

      <div>
        <h3 class="text-lg font-semibold">Roles</h3>
        <div class="mt-3 grid grid-cols-2 gap-3 tablet:grid-cols-5">
          {ROLES.map(([name, bg]) => (
            <div class="flex items-center gap-3 rounded-lg border border-border bg-white p-2">
              <span class={`size-8 shrink-0 rounded-md ${bg}`}></span>
              <span class="text-sm font-medium wrap-anywhere">{name}</span>
            </div>
          ))}
        </div>
      </div>

      <div>
        <h3 class="text-lg font-semibold">Type (Cuprum)</h3>
        <div class="mt-3 divide-y divide-border rounded-card border border-border bg-white">
          {TYPE.map(([cls, size, sample]) => (
            <div class="flex flex-col gap-1 px-4 py-3 tablet:flex-row tablet:items-baseline tablet:gap-6">
              <span class="w-40 shrink-0 font-mono text-xs text-muted-foreground">{cls} · {size}</span>
              <span class={`${cls} ${cls === "text-xl" || cls === "text-2xl" || cls === "text-3xl" ? "font-semibold" : ""}`}>{sample}</span>
            </div>
          ))}
          <div class="flex flex-wrap gap-6 px-4 py-3">
            <span class="font-normal">400 body</span><span class="font-medium">500 buttons, labels</span><span class="font-semibold">600 headings</span>
          </div>
        </div>
      </div>

      <div class="grid gap-6 tablet:grid-cols-2">
        <div>
          <h3 class="text-lg font-semibold">Corners</h3>
          <div class="mt-3 flex flex-wrap items-end gap-4">
            <div class="text-center"><div class="h-12 w-24 rounded-lg border-2 border-primary bg-white"></div><div class="mt-1 text-sm text-muted-foreground">controls 8px</div></div>
            <div class="text-center"><div class="h-20 w-28 rounded-card border-2 border-primary bg-white"></div><div class="mt-1 text-sm text-muted-foreground">cards 16px</div></div>
            <div class="text-center"><div class="h-12 w-28 rounded-full border-2 border-primary bg-white"></div><div class="mt-1 text-sm text-muted-foreground">pill: hero action</div></div>
          </div>
        </div>
        <div>
          <h3 class="text-lg font-semibold">Shadows</h3>
          <div class="mt-3 flex flex-wrap gap-6">
            {["shadow-sm", "shadow-md", "shadow-lg"].map(s => (
              <div class="text-center"><div class={`h-16 w-24 rounded-lg bg-white ${s}`}></div><div class="mt-2 text-sm text-muted-foreground">{s}</div></div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Surfaces -->
    {SURFACES.map(surface => (
      <section id={surface.id} class={`px-4 py-8 tablet:px-8 ${surfacePanel[surface.id]}`} style={photo(surface.id)}>
        <div class={surface.id === "paper" ? "rounded-card bg-white/80 p-4" : ""}>
          <p class={`${kicker} ${muted(surface.id)} ${onPhoto(surface.id)}`}>Surface</p>
          <h2 class={`${sectionTitle} ${onPhoto(surface.id)}`}>{surface.name}</h2>
          <p class={`mt-1 ${surface.id === "paper" ? "text-zinc-700" : "text-zinc-300"} ${onPhoto(surface.id)}`}>{surface.note}</p>
        </div>

        <div class={`mt-6 space-y-10 ${surfaceCard[surface.id] ? `${surfaceCard[surface.id]} p-4 tablet:p-6` : ""}`}>
          <!-- Buttons by state -->
          <div>
            <h3 class={`text-lg font-semibold ${onPhoto(surface.id)}`}>Buttons</h3>
            <p class={`mt-1 text-sm tablet:hidden ${muted(surface.id)} ${onPhoto(surface.id)}`}>Scroll the table sideways for every state.</p>
            <div class="mt-3 overflow-x-auto">
              <table class="min-w-180 border-separate border-spacing-x-2 border-spacing-y-3 text-left">
                <thead>
                  <tr>
                    <th class={`text-sm font-medium ${muted(surface.id)}`}>Variant</th>
                    {STATES.map(state => <th class={`text-sm font-medium ${muted(surface.id)}`}>{STATE_NOTES[state]}</th>)}
                  </tr>
                </thead>
                <tbody>
                  {BUTTON_VARIANTS.map(v => (
                    <tr>
                      <td class="align-middle">
                        <div class={`text-sm font-medium ${onPhoto(surface.id)}`}>{v.name}</div>
                        <div class={`text-xs ${muted(surface.id)} ${onPhoto(surface.id)}`}>{v.use}</div>
                      </td>
                      {STATES.map(state => (
                        <td class="align-middle whitespace-nowrap">
                          {v.id === "link"
                            ? <a href="#" class={cn(buttonVariants({ variant: "link", surface: toneOf(surface.id) }), forced(v.id, surface.id, state), state === "disabled" && "pointer-events-none opacity-50")} aria-disabled={state === "disabled" ? "true" : undefined}>Check out</a>
                            : (
                              <Button variant={v.id} surface={toneOf(surface.id)} className={forced(v.id, surface.id, state)} disabled={state === "disabled"} loading={state === "loading"}>
                                {v.id === "brand" ? "Send me a magic link!" : v.id === "primary" ? "Rock'n'Roll!" : v.id === "secondary" ? "Nah, never mind" : v.id === "ghost" ? "Change" : v.id === "ghost-destructive" ? "Delete this party" : "Delete my account"}
                              </Button>
                            )}
                        </td>
                      ))}
                    </tr>
                  ))}
                  {surface.id !== "paper" && PILL_BUTTONS.map(p => (
                    <tr>
                      <td class="align-middle">
                        <div class={`text-sm font-medium ${onPhoto(surface.id)}`}>{p.name}</div>
                        <div class={`text-xs ${muted(surface.id)} ${onPhoto(surface.id)}`}>{p.use}</div>
                      </td>
                      {STATES.map(state => (
                        <td class="align-middle whitespace-nowrap">
                          <Button variant={p.variant} size={p.size} surface={toneOf(surface.id)} pill className={forced(p.variant, surface.id, state)} disabled={state === "disabled"} loading={state === "loading"}>
                            {p.label}
                          </Button>
                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <!-- Sizes and shapes -->
          <div>
            <h3 class={`text-lg font-semibold ${onPhoto(surface.id)}`}>Sizes and shapes</h3>
            <div class="mt-3 flex flex-wrap items-center gap-3">
              <Button variant="primary" size="sm" surface={toneOf(surface.id)}>Save</Button>
              <Button variant="primary" size="md" surface={toneOf(surface.id)}>🎉 Rock'n'Roll!</Button>
              <Button variant="primary" size="lg" surface={toneOf(surface.id)}>OK, let's roll the dice!</Button>
              <Button variant="secondary" size="sm" surface={toneOf(surface.id)}>Show more parties</Button>
              <Button variant="ghost" size="sm" surface={toneOf(surface.id)}>Cancel</Button>
              {surface.id !== "paper" && (
                <Button variant="brand" size="lg" surface={toneOf(surface.id)} pill>Enter with your email address</Button>
              )}
            </div>
            <div class={`mt-2 text-sm ${muted(surface.id)} ${onPhoto(surface.id)}`}>
              sm 32px · md 40px · lg 48px{surface.id !== "paper" && " · pill only for a hero screen's main action"}
            </div>
            <div class="mt-4 max-w-sm">
              <Button variant="primary" surface={toneOf(surface.id)} fullWidth>Send me a magic link!</Button>
              <div class={`mt-1 text-sm ${muted(surface.id)} ${onPhoto(surface.id)}`}>fullWidth: the main action in dialogs and the sign-in card on phones</div>
            </div>
          </div>

          <!-- Form fields -->
          {surface.id !== "night" && (
            <div>
              <h3 class="text-lg font-semibold">Form fields</h3>
              <div class="mt-3 grid gap-6 tablet:grid-cols-2 desktop:grid-cols-3">
                {([
                  ["default", "Party name", "", "Optional", "Leave it blank to allow access via a shared link."],
                  ["focus", "Party name", "Office Secret Santa 2026", "", ""],
                  ["filled", "Party name", "Office Secret Santa 2026", "", ""],
                  ["error", "Secret phrase", "x".repeat(101), "", ""],
                  ["disabled", "Party name", "Office Secret Santa 2026", "", "Sending…"],
                  ["live", "Email", "", "Email address for a magic link", "We'll send you a magic link to sign in."],
                ] as const).map(([state, text, value, placeholder, hint]) => (
                  <div>
                    <div class={`mb-2 text-xs ${muted(surface.id)}`}>{state}</div>
                    <label class={`mb-1 block ${label(surface.id)}`} for={`${surface.id}-${state}`}>{text}</label>
                    <Input
                      id={`${surface.id}-${state}`}
                      surface={toneOf(surface.id)}
                      size={surface.id === "glass" ? "lg" : "md"}
                      className={state === "focus" ? fieldFocus(surface.id) : undefined}
                      defaultValue={value}
                      placeholder={placeholder}
                      disabled={state === "disabled"}
                      aria-invalid={state === "error" ? true : undefined}
                      aria-describedby={`${surface.id}-${state}-note`}
                      maxLength={state === "error" ? undefined : 100}
                    />
                    {state === "error"
                      ? <p id={`${surface.id}-${state}-note`} class={`mt-1 ${error(surface.id)}`}>Secret phrase must be at most 100 characters</p>
                      : hint && <p id={`${surface.id}-${state}-note`} class={`mt-1 ${help(surface.id)}`}>{hint}</p>}
                  </div>
                ))}
              </div>
              {surface.id === "glass" && <p class="mt-3 text-sm text-zinc-400">Glass forms use the dark input, 48px tall.</p>}
            </div>
          )}

          {surface.id === "paper" && (
            <div class="grid gap-8 desktop:grid-cols-2">
              <div>
                <h3 class="text-lg font-semibold">Label beside the input</h3>
                <p class="mt-1 text-sm text-muted-foreground">NewParty and JoinParty dialogs: from tablet width up; stacked below.</p>
                <div class="mt-4 space-y-4">
                  {[["Party name", "Office Secret Santa 2026", ""], ["Secret phrase", "", "Everyone must know this phrase for entry. Leave it blank to allow access via a shared link."]].map(([text, value, hint]) => (
                    <div class="tablet:flex tablet:gap-4">
                      <label class="mb-1 block text-base font-semibold text-zinc-700 tablet:mb-0 tablet:w-37.5 tablet:shrink-0 tablet:text-right tablet:leading-10" for={`beside-${text}`}>{text}</label>
                      <div class="min-w-0 flex-1">
                        <Input id={`beside-${text}`} defaultValue={value} placeholder={value ? "" : "Optional"} />
                        {hint && <p class="mt-1 text-sm text-muted-foreground">{hint}</p>}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
              <div>
                <h3 class="text-lg font-semibold">Inline field</h3>
                <p class="mt-1 text-sm text-muted-foreground">Profile settings: input and button on one line, same height; the error below both.</p>
                <div class="mt-4 space-y-5">
                  <div>
                    <div class="text-sm font-medium text-zinc-700">Name</div>
                    <div class="mt-1 flex items-start gap-2">
                      <Input size="sm" defaultValue="Alice" aria-label="Name" />
                      <Button variant="primary" size="sm" surface="light" disabled>Save</Button>
                    </div>
                    <p class="mt-1 text-sm text-muted-foreground">Save turns on once the name changes.</p>
                  </div>
                  <div>
                    <div class="text-sm font-medium text-zinc-700">Email</div>
                    <div class="mt-1 flex items-start gap-2">
                      <Input size="sm" defaultValue="alice@example.com" aria-label="New email" aria-invalid={true} />
                      <Button variant="primary" size="sm" surface="light">Send link</Button>
                      <Button variant="ghost" size="sm" surface="light">Cancel</Button>
                    </div>
                    <p class="mt-1 text-sm text-destructive">That's already your email.</p>
                  </div>
                  <div class="rounded-lg border border-red-200 bg-red-50 p-3">
                    <div class="flex flex-wrap items-center justify-between gap-3">
                      <div>
                        <div class="text-sm font-medium text-zinc-900">Delete account</div>
                        <div class="text-sm text-zinc-600">Removes your account and the parties you host that haven't rolled the dice yet.</div>
                      </div>
                      <Button variant="ghost-destructive" size="sm" surface="light">Delete account</Button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          )}
        </div>
      </section>
    ))}

    <!-- Dialogs -->
    <section id="dialogs" class="relative bg-night bg-cover bg-center px-4 py-8 tablet:px-8" style={photo("night")}>
      <div class="absolute inset-0 bg-night/70" aria-hidden="true"></div>
      <div class="relative">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h2 class={`${sectionTitle} text-white`}>Dialogs</h2>
            <p class="mt-1 text-zinc-300">On the night backdrop at 70%. Widths: sm 600px, md 700px, lg 800px; on phones, full width minus 16px.</p>
          </div>
          <Button variant="ghost" surface="dark" className="size-10 shrink-0 px-0" aria-label="Close"><Fragment set:html={iconX} /></Button>
        </div>

        <div class="mt-6 flex flex-col items-center gap-8">
          <div class="w-full max-w-150 rounded-card bg-white p-4 text-zinc-900 shadow-lg tablet:p-6" role="dialog" aria-labelledby="kit-dialog-1">
            <h3 id="kit-dialog-1" class="text-xl font-semibold">Let's start a new party!</h3>
            <div class="mt-5 space-y-4">
              {[["Party name", "Very funny secret party!", ""], ["Secret phrase", "", "Everyone must know this phrase for entry. Leave it blank to allow access via a shared link."]].map(([text, value, hint]) => (
                <div class="tablet:flex tablet:gap-4">
                  <label class="mb-1 block text-base font-semibold text-zinc-700 tablet:mb-0 tablet:w-37.5 tablet:shrink-0 tablet:text-right tablet:leading-10" for={`dlg-${text}`}>{text}</label>
                  <div class="min-w-0 flex-1">
                    <Input id={`dlg-${text}`} defaultValue={value} placeholder={value ? "" : "Optional"} />
                    {hint && <p class="mt-1 text-sm text-muted-foreground">{hint}</p>}
                  </div>
                </div>
              ))}
              <p class="text-sm text-muted-foreground tablet:pl-41.5">Have a question? <a href="#" class={buttonVariants({ variant: "link", surface: "light" })}>Check out</a> how this works.</p>
            </div>
            <div class="mt-6 flex flex-col-reverse gap-2 tablet:flex-row tablet:justify-end">
              <Button variant="secondary" surface="light" className="max-tablet:w-full">Nah, never mind</Button>
              <Button variant="primary" surface="light" className="max-tablet:w-full">🎉 Rock'n'Roll!</Button>
            </div>
          </div>

          <div class="w-full max-w-150 rounded-card bg-red-50 p-4 text-zinc-900 shadow-lg tablet:p-6" role="dialog" aria-labelledby="kit-dialog-2">
            <h3 id="kit-dialog-2" class="text-xl font-semibold text-red-800">Delete this party?</h3>
            <div class="mt-4 space-y-4">
              <p><strong>Very funny secret party</strong> will disappear for everyone who joined, and its link will stop working.</p>
              <p>Changed your mind? You can restore it from this page within 24 hours. After that it's gone for good.</p>
            </div>
            <div class="mt-6 flex flex-col-reverse gap-2 tablet:flex-row tablet:justify-end">
              <Button variant="secondary" surface="light" className="max-tablet:w-full">Keep it</Button>
              <Button variant="destructive" surface="light" className="max-tablet:w-full">💥 Yes, delete it</Button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Countdown -->
    <section id="countdown" class="bg-zinc-100 px-4 py-8 tablet:px-8">
      <h2 class={sectionTitle}>Countdown</h2>
      <p class="mt-1 max-w-200 text-muted-foreground">
        The party page counts down to the party's due time, if the host set one: roughly when they'll roll the dice. In
        the Party'o'meter's look, above the party's name, centred like it: its flip
        tickets in four groups (days, hours, minutes, seconds), a label under each, and "The party starts in about" over
        them, only "in about" underlined like "Jeez!", with the date in a bubble on hover, tap or focus. A digit flips
        straight to its new value when it changes. It ticks every second while the tab is visible. When the time is up
        it shows 0:00:00:00 and nothing else happens. With reduced motion the digits just change.
      </p>
      <div class="mt-4">
        <CountdownDemo client:load />
      </div>
    </section>

    <!-- Tabs -->
    <section id="tabs" class="bg-zinc-100 px-4 py-8 tablet:px-8">
      <h2 class={sectionTitle}>Tabs</h2>
      <p class="mt-1 text-muted-foreground">Profile dialog: route links in a nav, the current one marked with aria-current.</p>
      <div class="mt-4 max-w-200 overflow-hidden rounded-card bg-white shadow-lg">
        <nav class="flex border-b border-border" aria-label="Profile">
          <a href="#tabs" aria-current="page" class="flex-1 border-b-2 border-primary py-3 text-center text-lg font-medium text-zinc-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring">Profile</a>
          <a href="#tabs" class="flex-1 border-b-2 border-transparent py-3 text-center text-lg font-medium text-muted-foreground transition-colors duration-150 hover:text-zinc-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring">Latest history</a>
        </nav>
        <div class="p-4 text-muted-foreground tablet:p-6">The current tab: 2px turquoise underline. Others: muted, darker on hover.</div>
      </div>
    </section>

    <!-- Toasts -->
    <section id="toasts" class="grid gap-0 tablet:grid-cols-2">
      {(["night", "paper"] as const).map(s => (
        <div class={`px-4 py-8 tablet:px-8 ${surfacePanel[s]}`} style={photo(s)}>
          <h2 class={`${sectionTitle} ${s === "night" ? "text-white text-shadow-photo" : ""}`}>Toasts on {s}</h2>
          <p class={`mt-1 text-sm ${s === "night" ? "text-zinc-300 text-shadow-photo" : "text-muted-foreground"}`}>The app's toaster: errors go after 2.5 s, messages after 4 s, reminders stay until dismissed or opened.</p>
          <div class="mt-4">
            <ToastDemo client:load tone={s === "night" ? "dark" : "light"} longEmail={LONG_EMAIL} />
          </div>
        </div>
      ))}
    </section>

    <!-- Party'o'meter -->
    <section id="party-o-meter" class="landing bg-night px-4 py-8 tablet:px-8">
      <h2 class={`${sectionTitle} text-white`}>Party'o'meter</h2>
      <p class="mt-1 max-w-200 text-sm text-zinc-300">
        The front door's count of parties that rolled the dice: a row of raffle tickets, at least five, cream with red
        digits and notched sides, leaning a little. The digits are drawn as SVG, condensed and geometric in the spirit of
        DIN. To change, a ticket's top half folds down onto the next digit; a jump flips through every digit in between.
        Clicking a counter puts on a little show: its tickets flip to random digits, then to zeros, then up to the count. With reduced motion the digits just change. The samples flip up from 00000 on load, like the real one when its
        first count arrives.
      </p>
      <h3 class="mt-6 text-xl font-semibold text-white">Try it</h3>
      <p class="mt-1 text-sm text-zinc-300">Change the count and watch the tickets: one flip, a few, a run of fast flips, a new digit, and back down (which flips forward round to the lower digits, as a counter would).</p>
      <div class="mt-4 max-w-200">
        <OdometerDemo client:load />
      </div>
      <h3 class="mt-10 text-xl font-semibold text-white">Now and then</h3>
      <p class="mt-1 max-w-200 text-sm text-zinc-300">
        On its own, rarely, the counter plays the click's show: on the front door after a random 1 to 3 minutes, here
        every 3 to 6 seconds. Only while it's in view in a visible tab, not right after its digits changed, never over a
        show already playing, and not at all with reduced motion.
      </p>
      <div class="mt-4 max-w-200">
        <OdometerNowAndThen client:load />
      </div>
      <h3 class="mt-10 text-xl font-semibold text-white">States</h3>
      <div class="mt-3">
        <OdometerStates client:load />
      </div>
    </section>

    <!-- Long values -->
    <section id="long-values" class="space-y-6 px-4 py-8 tablet:px-8">
      <h2 class={sectionTitle}>Long values</h2>
      <p class="text-muted-foreground">The longest the API allows. Running text wraps anywhere; one-line slots truncate with the full value on hover.</p>
      <div class="rounded-card bg-white p-4 shadow-lg tablet:p-6">
        <h3 class="text-2xl font-semibold wrap-anywhere">{LONG_PARTY}</h3>
        <p class="mt-3 wrap-anywhere">Hey, {LONG_NAME}! From now on, we know you as <strong>{LONG_EMAIL}</strong>.</p>
        <div class="mt-4 flex min-w-0 items-center gap-3 rounded-lg border border-border p-3">
          <span class="size-10 shrink-0 rounded-full bg-cream-50"></span>
          <div class="min-w-0">
            <div class="truncate font-semibold" title={LONG_PARTY}>{LONG_PARTY}</div>
            <div class="truncate text-sm text-muted-foreground" title={LONG_NAME}>You host · {LONG_NAME}</div>
          </div>
        </div>
        <div class="mt-4">
          <label class="mb-1 block text-sm font-medium text-zinc-700" for="long-input">Your name for this party</label>
          <Input id="long-input" defaultValue={LONG_NAME} maxLength={MAX_PERSON_NAME_LENGTH} />
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
